<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PsViethoa.FpkgBuilder.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PsViethoa.FpkgBuilder.App/Styles/Tokens.axaml" />
                <ResourceInclude Source="avares://PsViethoa.FpkgBuilder.App/Styles/Icons.axaml" />
                <ResourceInclude Source="avares://PsViethoa.FpkgBuilder.App/Styles/ControlThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PsViethoa.FpkgBuilder.App/Styles/Controls.axaml" />
    </Application.Styles>

</Application>
