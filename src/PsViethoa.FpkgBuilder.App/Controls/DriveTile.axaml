<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PsViethoa.FpkgBuilder.App.ViewModels"
             x:Class="PsViethoa.FpkgBuilder.App.Controls.DriveTile"
             x:DataType="vm:DriveChoice">
    <!-- Chip ổ đĩa gọn: hàng trên icon ổ cứng + "C:", hàng dưới dung lượng trống. -->
    <StackPanel Spacing="2" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Canvas Width="26" Height="18" VerticalAlignment="Center">
                <Border Canvas.Left="0.5" Canvas.Top="3" Width="25" Height="11" CornerRadius="2.5" BorderBrush="#6B7280" BorderThickness="0.7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#F4F5F7" Offset="0" />
                            <GradientStop Color="#C9CED6" Offset="0.55" />
                            <GradientStop Color="#8E97A3" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Rectangle Canvas.Left="2.5" Canvas.Top="9.8" Width="21" Height="2.5" RadiusX="1" RadiusY="1" Fill="#3F4753" />
                <Ellipse Canvas.Left="20" Canvas.Top="10" Width="2.4" Height="2.1" Fill="#34D399" />
                <!-- dấu ✓ khi đang chọn -->
                <Border Canvas.Left="15" Canvas.Top="-3" Width="11" Height="11" CornerRadius="5.5" Background="{DynamicResource AccentBrush}"
                        IsVisible="{Binding IsSelected}" BorderBrush="White" BorderThickness="1">
                    <PathIcon Width="6" Height="6" Foreground="White" Data="{StaticResource IconCheck}" />
                </Border>
            </Canvas>
            <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding Free}" FontSize="10.5" Opacity="0.8" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
