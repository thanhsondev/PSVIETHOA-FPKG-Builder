<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PsViethoa.FpkgBuilder.App.ViewModels"
             x:Class="PsViethoa.FpkgBuilder.App.Controls.DriveTile"
             x:DataType="vm:DriveChoice">
    <!-- Chip ổ đĩa gọn: icon ổ cứng (kiểu This PC) + "C:" + một dòng dung lượng trống. -->
    <Grid ColumnDefinitions="Auto,Auto">
        <Canvas Width="34" Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
            <!-- thân ổ: mặt trên sáng, cạnh trước đậm, đèn xanh -->
            <Border Canvas.Left="1" Canvas.Top="7" Width="32" Height="14" CornerRadius="3" BorderBrush="#6B7280" BorderThickness="0.8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#F4F5F7" Offset="0" />
                        <GradientStop Color="#C9CED6" Offset="0.55" />
                        <GradientStop Color="#8E97A3" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Rectangle Canvas.Left="3.5" Canvas.Top="15.8" Width="27" Height="3.2" RadiusX="1.2" RadiusY="1.2" Fill="#3F4753" />
            <Ellipse Canvas.Left="26" Canvas.Top="16" Width="3" Height="2.7" Fill="#34D399" />
            <!-- dấu ✓ khi đang chọn -->
            <Border Canvas.Left="21" Canvas.Top="0" Width="13" Height="13" CornerRadius="6.5" Background="{DynamicResource AccentBrush}"
                    IsVisible="{Binding IsSelected}" BorderBrush="White" BorderThickness="1.1">
                <PathIcon Width="7" Height="7" Foreground="White" Data="{StaticResource IconCheck}" />
            </Border>
        </Canvas>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="13.5" />
            <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.8" />
        </StackPanel>
    </Grid>
</UserControl>
