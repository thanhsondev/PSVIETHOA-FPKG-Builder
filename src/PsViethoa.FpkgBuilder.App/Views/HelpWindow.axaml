<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:PsViethoa.FpkgBuilder.App.Localization"
        x:Class="PsViethoa.FpkgBuilder.App.Views.HelpWindow"
        Title="{l:T Help.WindowTitle}"
        Width="680" Height="760" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Padding="24,18">
            <Grid ColumnDefinitions="Auto,14,*">
                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconHelp}" Width="22" Height="22" Foreground="{DynamicResource OnAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{l:T Help.Title}" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock Text="{l:T Help.Subtitle}" FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Name="HelpScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <!-- Lề đặt ở Margin của khối nội dung (không dùng ScrollViewer.Padding) để chiều rộng được đo đúng, không tràn phải. -->
            <StackPanel Spacing="14" Margin="22,18">

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Quick.Title}" />
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="1.  " /><Run Text="{l:T Help.Quick.1}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="2.  " /><Run Text="{l:T Help.Quick.2}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="3.  " /><Run Text="{l:T Help.Quick.3}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="4.  " /><Run Text="{l:T Help.Quick.4}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="5.  " /><Run Text="{l:T Help.Quick.5}" /></TextBlock>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Speed.Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Speed.1}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Speed.2}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Speed.3}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Speed.4}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Speed.5}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Speed.6}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Notes.Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Notes.1}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Notes.2}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Notes.3}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Notes.4}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Notes.5}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Notes.6}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Notes.7}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Extract.Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Extract.1}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Extract.2}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Extract.3}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Ps4.Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Ps4.1}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Ps4.2}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Ps4.3}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Ps4.4}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Ftp.Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Ftp.1}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Ftp.2}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Ftp.3}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Save.Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Save.1}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Save.2}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.Save.3}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.Keys.Title}" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono secondary" Text="Ctrl/⌘ + B · F5" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:T Help.Keys.Build}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono secondary" Text="Esc" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:T Help.Keys.Cancel}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="mono secondary" Text="F1" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{l:T Help.Keys.Help}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="mono secondary" Text="Ctrl/⌘ + L" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{l:T Help.Keys.CopyLog}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="{l:T Help.Credits.Title}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" >
                            <Image Grid.Row="0" Source="avares://PsViethoa.FpkgBuilder.App/Assets/icon-128.png" Width="40" Height="40" Margin="0,0,12,10" VerticalAlignment="Top" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,10">
                                <TextBlock Classes="h3" Text="{l:T Help.Credits.Team}" TextWrapping="Wrap" />
                                <TextBlock Classes="small muted" Text="{l:T Help.Credits.TeamRole}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Row="1" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource InfoSoftBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <PathIcon Classes="info" Data="{StaticResource IconPackage}" Width="20" Height="20" />
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                <TextBlock Classes="h3" Text="{l:T Help.Credits.Main}" TextWrapping="Wrap" />
                                <TextBlock Classes="small muted" Text="{l:T Help.Credits.MainRole}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="small muted" Text="{l:T Help.Credits.Thanks}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:T Help.About.Title}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:T Help.About.Body}" />
                        <Button Classes="ghost" HorizontalAlignment="Left" Click="OpenAuthor_Click">
                            <StackPanel Classes="btn">
                                <PathIcon Data="{StaticResource IconOpenExternal}" />
                                <TextBlock Text="{l:T Help.About.Author}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid ColumnDefinitions="*,16,Auto">
                <TextBlock Name="VersionText" Classes="small muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="{l:T Common.Close}" MinWidth="110" Click="Close_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
