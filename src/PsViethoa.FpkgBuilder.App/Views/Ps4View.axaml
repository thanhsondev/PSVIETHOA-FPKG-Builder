<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PsViethoa.FpkgBuilder.App.ViewModels"
             xmlns:models="using:PsViethoa.FpkgBuilder.Core.Models"
             xmlns:conv="using:PsViethoa.FpkgBuilder.App.Converters"
             xmlns:l="using:PsViethoa.FpkgBuilder.App.Localization"
             xmlns:c="using:PsViethoa.FpkgBuilder.App.Controls"
             x:Class="PsViethoa.FpkgBuilder.App.Views.Ps4View"
             x:DataType="vm:Ps4ViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <!-- Thẻ chuyển Thiết lập / param.sfo -->
        <Style Selector="ToggleButton.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        </Style>
        <!-- Fluent đặt màu chữ / nền của nút đang bật ngay trên ContentPresenter: phải đặt lại ở đó, không thì giao diện sáng
             thành chữ trắng trên nền tím nhạt. -->
        <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ps4SoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Ps4InkBrush}" />
        </Style>
        <Style Selector="ToggleButton.tab:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ps4SoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Ps4InkBrush}" />
        </Style>
        <Style Selector="ToggleButton.tab:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Ps4SoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Ps4InkBrush}" />
        </Style>
        <Style Selector="ToggleButton.tab:checked">
            <Setter Property="Foreground" Value="{DynamicResource Ps4InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton.tab:not(:checked):pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
        </Style>
        <!-- Form hẹp: nút chọn chỉ còn biểu tượng (chữ ở tooltip) để ô đường dẫn đủ rộng (Ps4View.axaml.cs). -->
        <Style Selector="StackPanel.compact TextBlock.pick">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Huy hiệu thông tin nguồn -->
        <Style Selector="Border.infobadge">
            <Setter Property="Background" Value="{DynamicResource Ps4SoftBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.infobadge > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ps4InkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.infobadge.ok">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        </Style>
        <Style Selector="Border.infobadge.ok > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.infobadge.warn">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
        </Style>
        <Style Selector="Border.infobadge.warn > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        </Style>
        <Style Selector="TextBlock.sfoerr">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.sfowarn">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.sfokey">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="TextBlock.sfokey.modified">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.sfokey.locked">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
        </Style>
        <Style Selector="ProgressBar.ps4 /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{DynamicResource Ps4InkBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Ps4SoftBrush" Color="#262A5A" />
                    <SolidColorBrush x:Key="Ps4InkBrush" Color="#A5B4FC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Ps4SoftBrush" Color="#E0E7FF" />
                    <SolidColorBrush x:Key="Ps4InkBrush" Color="#4F46E5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Cửa sổ thấp: trang cuộn được; khung thiết lập và khung thông tin giữ tối thiểu 360 px thay vì bị ép mất form (ViewportFill). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:ViewportFill.MinContentHeight="700">
    <Grid Margin="26,14,26,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="360" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ THIẾT LẬP ============ -->
            <Border Classes="card" Padding="18,14,10,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,8,10">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="section" Text="{Binding StepSourceTitle}" />
                            <TextBlock Classes="xs muted" Text="{Binding ModeHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="chip warning" Margin="10,0,0,0" IsVisible="{Binding IsSfoDirty}">
                            <TextBlock Text="{Binding SfoDirtyText}" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" IsVisible="{Binding ShowSfoTabs}">
                            <ToggleButton Classes="tab" IsChecked="{Binding ShowSettingsForm, Mode=OneWay}" Command="{Binding ShowSettingsCommand}" Content="{l:T Ps4.Tab.Settings}" />
                            <ToggleButton Classes="tab" IsChecked="{Binding ShowSfoEditor, Mode=OneWay}" Command="{Binding ShowSfoCommand}" Content="{l:T Ps4.Tab.Sfo}" />
                        </StackPanel>
                    </Grid>

                    <!-- Biểu mẫu -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowSettingsForm}">
                        <StackPanel Name="SettingsForm" IsEnabled="{Binding !IsBusy}" Margin="0,0,16,0">
                            <TextBlock Classes="caps" Text="{Binding SourceLabel}" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,8,Auto" Margin="0,0,0,6">
                                <TextBox Name="SourceBox" Classes="field" Text="{Binding SourcePath, Mode=TwoWay}" Watermark="{Binding SourceWatermark}" ToolTip.Tip="{l:T Ps4.Source.DropTip}" />
                                <!-- Nguồn là tệp PKG (Xả, Gộp) hay thư mục đã xả (Base, Update, DLC; Gộp nhận cả hai): mỗi nút nói rõ nó chọn gì. -->
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}" IsVisible="{Binding SourcePicksFile}" ToolTip.Tip="{l:T Ps4.PickPkg.Tip}">
                                    <StackPanel Classes="btn">
                                        <PathIcon Data="{StaticResource IconPackage}" />
                                        <TextBlock Classes="pick" Text="{l:T Ps4.PickPkg}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding BrowseSourceFolderCommand}" IsVisible="{Binding ShowSourceFolderButton}" ToolTip.Tip="{l:T Ps4.PickFolder.Tip}">
                                    <StackPanel Classes="btn">
                                        <PathIcon Data="{StaticResource IconFolder}" />
                                        <TextBlock Classes="pick" Text="{l:T Ps4.PickFolder}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Margin="8,0,0,0" Command="{Binding PickFilesCommand}" IsVisible="{Binding IsExtract}" ToolTip.Tip="{l:T Ps4.PickFilesTip}">
                                    <StackPanel Classes="btn">
                                        <PathIcon Data="{StaticResource IconSelectAll}" />
                                        <TextBlock Classes="pick" Text="{l:T Ps4.PickFiles}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="5" Classes="icon" Command="{Binding InspectCommand}" ToolTip.Tip="{l:T Ps4.Inspect.Tip}">
                                    <PathIcon Data="{StaticResource IconRefresh}" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="xs muted" Text="{Binding SelectionSummary}" IsVisible="{Binding IsExtract}" Margin="0,0,0,10" />

                            <StackPanel IsVisible="{Binding ShowBase}" Margin="0,4,0,0">
                                <TextBlock Classes="caps" Text="{Binding BaseLabel}" />
                                <Grid ColumnDefinitions="*,8,Auto,8,Auto" Margin="0,0,0,10">
                                    <TextBox Name="BaseBox" Classes="field" Text="{Binding BasePath, Mode=TwoWay}" Watermark="{l:T Ps4.Base.Watermark}" />
                                    <Button Grid.Column="2" Command="{Binding BrowseBaseCommand}" ToolTip.Tip="{l:T Ps4.PickPkg.Tip}">
                                        <StackPanel Classes="btn">
                                            <PathIcon Data="{StaticResource IconPackage}" />
                                            <TextBlock Classes="pick" Text="{l:T Ps4.PickPkg}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" Command="{Binding BrowseBaseFolderCommand}" ToolTip.Tip="{l:T Ps4.PickFolder.Tip}">
                                        <StackPanel Classes="btn">
                                            <PathIcon Data="{StaticResource IconFolder}" />
                                            <TextBlock Classes="pick" Text="{l:T Ps4.PickFolder}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel IsVisible="{Binding ShowBasePasscode}" Margin="0,0,0,10">
                                    <TextBlock Classes="caps" Text="{l:T Ps4.BasePasscode}" />
                                    <TextBox Classes="mono field" Text="{Binding BasePasscode, Mode=TwoWay}" MaxLength="32" Watermark="{l:T Ps4.BasePasscode.Watermark}" ToolTip.Tip="{l:T Ps4.BasePasscode.Tip}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Classes="caps" Text="{l:T Ps4.Output}" Margin="0,4,0,6" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Classes="field" Text="{Binding OutputFolder, Mode=TwoWay}" Watermark="{l:T Ps4.Output.Watermark}" />
                                <Button Grid.Column="2" Command="{Binding BrowseOutputCommand}" ToolTip.Tip="{l:T Common.PickFolder}">
                                    <StackPanel Classes="btn">
                                        <PathIcon Data="{StaticResource IconFolderOpen}" />
                                        <TextBlock Classes="pick" Text="{l:T Common.PickFolder}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Classes="xs muted" Text="{Binding OutputHint}" TextWrapping="Wrap" Margin="0,5,0,12" />

                            <Grid ColumnDefinitions="*,14,Auto">
                                <StackPanel>
                                    <TextBlock Classes="caps" Text="{Binding PasscodeLabel}" />
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <TextBox Classes="mono field" Classes.error="{Binding !PasscodeValid}" Text="{Binding Passcode, Mode=TwoWay}" MaxLength="32" />
                                        <Button Grid.Column="2" Command="{Binding RandomPasscodeCommand}" IsVisible="{Binding ShowRandomPass}" ToolTip.Tip="{l:T Ps4.RandomPassTip}">
                                            <StackPanel Classes="btn">
                                                <PathIcon Data="{StaticResource IconDice}" />
                                                <TextBlock Text="{l:T Ps4.RandomPass}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" IsVisible="{Binding ShowVersion}">
                                    <TextBlock Classes="caps" Text="{Binding VersionLabel}" />
                                    <Grid ColumnDefinitions="38,4,78,4,38" Height="36">
                                        <Button Command="{Binding VersionDownCommand}" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{l:T Ps4.VersionDownTip}">
                                            <TextBlock Text="−" FontSize="18" FontWeight="SemiBold" />
                                        </Button>
                                        <TextBox Name="VersionBox" Grid.Column="2" Classes="mono" Text="{Binding Version, Mode=TwoWay}" MaxLength="5" TextAlignment="Center" Watermark="01.00" ToolTip.Tip="{l:T Ps4.Version.Tip}" />
                                        <Button Grid.Column="4" Command="{Binding VersionUpCommand}" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{l:T Ps4.VersionUpTip}">
                                            <TextBlock Text="+" FontSize="18" FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,8" IsVisible="{Binding ShowVersion}">
                                <TextBlock Classes="xs muted" Text="{Binding SourceVersionText}" ToolTip.Tip="{Binding VersionHint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="link" Command="{Binding ResetVersionCommand}" Content="{l:T Ps4.Version.FromSource}" />
                            </Grid>

                            <CheckBox IsChecked="{Binding FullVerify, Mode=TwoWay}" IsEnabled="{Binding CanToggleVerify}" Content="{Binding FullVerifyLabel}" ToolTip.Tip="{Binding FullVerifyTip}" Margin="0,4,0,0" />

                            <Expander Header="{l:T Ps4.Advanced}" Margin="0,8,0,4" HorizontalAlignment="Stretch" IsExpanded="{Binding ShowAdvanced, Mode=TwoWay}">
                                <StackPanel Spacing="10" Margin="4,4,0,4">
                                    <CheckBox IsChecked="{Binding Gp4Only, Mode=TwoWay}" IsVisible="{Binding ShowGp4Only}" Content="{Binding Gp4OnlyLabel}" />
                                    <StackPanel IsVisible="{Binding ShowEntitlement}">
                                        <TextBlock Classes="caps" Text="{l:T Ps4.Entitlement}" />
                                        <TextBox Classes="mono field" Text="{Binding EntitlementKey, Mode=TwoWay}" MaxLength="32" Watermark="{l:T Ps4.Entitlement.Watermark}" ToolTip.Tip="{l:T Ps4.Entitlement.Tip}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="caps" Text="{l:T Ps4.Engine.Label}" />
                                        <Grid ColumnDefinitions="*,8,Auto">
                                            <TextBox Classes="field" Text="{Binding EnginePath, Mode=TwoWay}" Watermark="{l:T Ps4.Engine.Watermark}" />
                                            <Button Grid.Column="2" Command="{Binding BrowseEngineCommand}">
                                                <StackPanel Classes="btn">
                                                    <PathIcon Data="{StaticResource IconFile}" />
                                                    <TextBlock Text="{l:T Common.PickExe}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Trình sửa param.sfo (Đóng Update / Gộp) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowSfoEditor}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsEnabled="{Binding !IsBusy}" Margin="0,0,16,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="caps" Text="{l:T Ps4.SfoEdit.Heading}" Margin="0" />
                                <TextBlock Classes="xs muted" Text="{Binding SfoOrigin}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SfoOrigin}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost" Command="{Binding SfoReloadCommand}" ToolTip.Tip="{l:T Ps4.SfoEdit.Reload.Tip}">
                                    <StackPanel Classes="btn">
                                        <PathIcon Data="{StaticResource IconRefresh}" />
                                        <TextBlock Text="{l:T Ps4.SfoEdit.Reload}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SfoOpenCommand}" ToolTip.Tip="{l:T Ps4.SfoEdit.Open.Tip}">
                                    <StackPanel Classes="btn">
                                        <PathIcon Data="{StaticResource IconFile}" />
                                        <TextBlock Text="{l:T Ps4.SfoEdit.Open}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Command="{Binding SfoSaveCommand}">
                                    <StackPanel Classes="btn">
                                        <PathIcon Data="{StaticResource IconDownload}" />
                                        <TextBlock Text="{l:T Ps4.SfoEdit.Save}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Classes="surface" Padding="12,10" Margin="0,10,0,10" IsVisible="{Binding HasSfo}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Classes="caps" Text="{l:T Ps4.SfoEdit.QuickTitle}" Margin="0,0,0,2" />
                                    <TextBlock Classes="xs muted" Text="{l:T Ps4.SfoEdit.QuickTitle.Sub}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding SfoQuickTitle, Mode=TwoWay}" ToolTip.Tip="{l:T Ps4.SfoEdit.QuickTitle.Tip}" />
                                <CheckBox Grid.Column="2" IsChecked="{Binding SfoTitleAllLanguages, Mode=TwoWay}" Content="{l:T Ps4.SfoEdit.AllLanguages}" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="180,70,*,70" Margin="10,0,10,6" IsVisible="{Binding HasSfo}">
                            <TextBlock Classes="caps" Text="{l:T Ps4.SfoEdit.ColKey}" />
                            <TextBlock Grid.Column="1" Classes="caps" Text="{l:T Ps4.SfoEdit.ColType}" />
                            <TextBlock Grid.Column="2" Classes="caps" Text="{l:T Ps4.SfoEdit.ColValue}" />
                            <TextBlock Grid.Column="3" Classes="caps" Text="{l:T Ps4.SfoEdit.ColMax}" />
                        </Grid>
                        <Border Grid.Row="3" Classes="surface" Padding="4" MinHeight="120">
                            <Panel>
                                <ListBox ItemsSource="{Binding SfoRows}" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectedItem="{Binding SelectedSfoRow, Mode=TwoWay}" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:Ps4SfoRow">
                                            <Grid ColumnDefinitions="180,70,*,70" ToolTip.Tip="{Binding Tip}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Classes="sfokey" Classes.modified="{Binding IsModified}" Classes.locked="{Binding Locked}" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="xs muted" Text="{Binding Note}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Note, Converter={x:Static conv:AppConverters.NotEmpty}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Classes="small muted" Text="{Binding TypeLabel}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="2" Classes="mono" Classes.error="{Binding HasError}" Text="{Binding Value, Mode=TwoWay}" IsReadOnly="{Binding Locked}" Opacity="{Binding Locked, Converter={x:Static conv:AppConverters.LockedOpacity}}" FontSize="12.5" Margin="0,2,8,2" />
                                                <TextBlock Grid.Column="3" Classes="mono xs muted" Text="{Binding MaxText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="hint" Text="{l:T Ps4.SfoEdit.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20" IsVisible="{Binding !HasSfo}" />
                            </Panel>
                        </Border>
                        <Grid Grid.Row="4" ColumnDefinitions="160,6,*,Auto,8,Auto,6,Auto" Margin="0,10,0,0">
                            <TextBox Classes="mono" Text="{Binding SfoNewKey, Mode=TwoWay}" Watermark="TITLE_15" ToolTip.Tip="{l:T Ps4.SfoEdit.NewKey.Tip}" />
                            <TextBox Grid.Column="2" Text="{Binding SfoNewValue, Mode=TwoWay}" Watermark="{l:T Ps4.SfoEdit.NewValue}" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding SfoNewIsNumber, Mode=TwoWay}" Content="{l:T Ps4.SfoEdit.Number}" Margin="8,0,0,0" />
                            <Button Grid.Column="5" Command="{Binding SfoAddCommand}">
                                <StackPanel Classes="btn">
                                    <PathIcon Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="{l:T Ps4.SfoEdit.Add}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="7" Classes="ghost" Command="{Binding SfoRemoveCommand}">
                                <StackPanel Classes="btn">
                                    <PathIcon Data="{StaticResource IconTrash}" />
                                    <TextBlock Text="{l:T Ps4.SfoEdit.Remove}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="5" Classes="xs muted" Classes.sfoerr="{Binding SfoStatusError}" Classes.sfowarn="{Binding SfoStatusWarn}" Text="{Binding SfoStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </Grid>
                    </ScrollViewer>

                    <!-- Bắt đầu / Dừng -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,10,Auto" Margin="0,12,8,0">
                        <Button Classes="primary" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding StartCommand}">
                            <StackPanel Classes="btn">
                                <PathIcon Data="{StaticResource IconPlay}" />
                                <TextBlock Text="{Binding StartText}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="danger" MinHeight="44" MinWidth="110" HorizontalContentAlignment="Center" Command="{Binding StopCommand}" ToolTip.Tip="{l:T Ps4.Stop.Tip}">
                            <StackPanel Classes="btn">
                                <PathIcon Data="{StaticResource IconStop}" />
                                <TextBlock Text="{l:T Common.Stop}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ THÔNG TIN NGUỒN ============ -->
            <Border Grid.Column="2" Classes="card" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="96" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel Width="92" Height="92" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Border CornerRadius="18" ClipToBounds="True" Background="{DynamicResource MutedBrush}">
                                <Panel>
                                    <Border IsVisible="{Binding !HasIcon}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="60%,100%">
                                                <GradientStop Offset="0" Color="#818CF8" />
                                                <GradientStop Offset="1" Color="#312E81" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="PS4" FontWeight="Black" FontStyle="Italic" FontSize="24" LineHeight="32" Padding="0,0,3,0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding InfoIcon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                                </Panel>
                            </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="caps" Text="{l:T Ps4.Info.Heading}" Margin="0" />
                            <TextBlock Text="{Binding InfoTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="66" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,8">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="small muted" Text="{Binding InfoSubtitle}" TextWrapping="Wrap" />
                            <StackPanel>
                                <TextBlock Classes="caps" Text="CONTENT ID" />
                                <SelectableTextBlock Classes="mono small" Text="{Binding InfoContentId}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel>
                                    <TextBlock Classes="caps" Text="TITLE ID" />
                                    <SelectableTextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding InfoTitleId}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="caps" Text="{l:T Ps4.Info.Version}" />
                                    <TextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding InfoVersion}" ToolTip.Tip="{Binding VersionHint}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Classes="thin ps4" IsVisible="{Binding IsInspecting}" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <!-- Trạng thái nguồn nằm ngoài vùng cuộn để không bị cắt khi cửa sổ thấp. -->
                        <Border Classes="infobadge" Classes.ok="{Binding InfoOk}" Classes.warn="{Binding InfoWarn}" Margin="0,0,0,2">
                            <TextBlock Text="{Binding InfoBadge}" TextWrapping="Wrap" />
                        </Border>
                        <!-- Thư mục kết quả và tệp nhật ký nằm cùng một hàng để vùng thông tin phía trên còn chỗ. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenResultCommand}" ToolTip.Tip="{l:T Ps4.OpenResult}">
                                <StackPanel Classes="btn">
                                    <PathIcon Data="{StaticResource IconFolderOpen}" />
                                    <TextBlock Text="{l:T Ps4.OpenResult}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding OpenLogCommand}" IsVisible="{Binding LastLog, Converter={x:Static conv:AppConverters.NotEmpty}}" ToolTip.Tip="{l:T Ps4.OpenLog.Tip}">
                                <StackPanel Classes="btn">
                                    <PathIcon Data="{StaticResource IconTerminal}" />
                                    <TextBlock Text="{l:T Ps4.OpenLog.Short}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ TIẾN ĐỘ ============ -->
        <Border Grid.Row="2" Classes="card" Padding="18,12">
            <Grid RowDefinitions="Auto,8,Auto,8,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Ellipse Classes="dot" Classes.working="{Binding IsBusy}" Classes.success="{Binding Succeeded}" Classes.error="{Binding Failed}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="metric" FontFamily="{DynamicResource ContentControlThemeFontFamily}" Text="{Binding PhaseText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="xs muted" Text="{l:T Ps4.Progress.Estimated}" IsVisible="{Binding Estimated}" VerticalAlignment="Center" Margin="10,0" />
                    <TextBlock Grid.Column="3" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ps4InkBrush}" Text="{Binding Percent, StringFormat={}{0:0.0}%}" VerticalAlignment="Center" MinWidth="72" TextAlignment="Right" />
                </Grid>
                <ProgressBar Grid.Row="2" Classes="ps4" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
                <Grid Grid.Row="4" ColumnDefinitions="*,150,110,110">
                    <TextBlock Classes="small muted" Text="{Binding DetailText}" ToolTip.Tip="{Binding DetailText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="caps" Text="{l:T Ps4.Progress.Speed}" Margin="0" />
                        <TextBlock Classes="metric" Text="{Binding SpeedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="caps" Text="{l:T Ps4.Progress.Elapsed}" Margin="0" />
                        <TextBlock Classes="metric" Text="{Binding ElapsedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Classes="caps" Text="{l:T Ps4.Progress.Remaining}" Margin="0" />
                        <TextBlock Classes="metric" Text="{Binding EtaText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ NHẬT KÝ ============ -->
        <Border Grid.Row="4" Classes="card" Padding="14,10" Height="170">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
                    <TextBlock Classes="section" FontSize="13" Text="{l:T Common.Log}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="chip" Margin="10,0,0,0"><TextBlock Classes="mono" Text="{Binding LogCountText}" /></Border>
                    <TextBox Grid.Column="3" Width="220" Text="{Binding LogFilter, Mode=TwoWay}" Watermark="{l:T Save.Log.Filter}" Margin="0,0,8,0" />
                    <Button Grid.Column="4" Classes="ghost" Command="{Binding CopyLogCommand}">
                        <StackPanel Classes="btn">
                            <PathIcon Data="{StaticResource IconCopy}" />
                            <TextBlock Text="{l:T Save.Log.Copy}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Classes="ghost" Command="{Binding ClearLogCommand}" Margin="4,0,0,0">
                        <StackPanel Classes="btn">
                            <PathIcon Data="{StaticResource IconTrash}" />
                            <TextBlock Text="{l:T Save.Log.Clear}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource LogBgBrush}" CornerRadius="8" Padding="6,4">
                    <Panel>
                        <ListBox Name="LogList" Classes="log" ItemsSource="{Binding VisibleLog}" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogEntry">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="logtime" Text="{Binding TimeText}" />
                                        <TextBlock Grid.Column="1" Classes="logmsg" Classes.warn="{Binding IsWarning}" Classes.err="{Binding IsError}" Classes.ok="{Binding IsSuccess}" Text="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="small faint" Text="{l:T Ps4.Log.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="30"
                                   IsVisible="{Binding VisibleLog.Count, Converter={x:Static conv:AppConverters.IsZero}}" />
                    </Panel>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
