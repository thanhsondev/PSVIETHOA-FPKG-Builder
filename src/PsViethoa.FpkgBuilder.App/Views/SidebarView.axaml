<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PsViethoa.FpkgBuilder.App.ViewModels"
             xmlns:shell="using:PsViethoa.FpkgBuilder.App.ViewModels.Shell"
             xmlns:c="using:PsViethoa.FpkgBuilder.App.Controls"
             xmlns:conv="using:PsViethoa.FpkgBuilder.App.Converters"
             xmlns:l="using:PsViethoa.FpkgBuilder.App.Localization"
             x:Class="PsViethoa.FpkgBuilder.App.Views.SidebarView"
             x:DataType="vm:MainViewModel">

    <!-- Thanh bên luôn tối ở cả hai theme. Lớp nền: dải màu đứng + quầng sáng logo + hạt sáng mờ. -->
    <Border BorderBrush="#1A2440" BorderThickness="0,0,1,0" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#0E1630" />
                <GradientStop Offset="0.45" Color="#0A1124" />
                <GradientStop Offset="1" Color="#080D1C" />
            </LinearGradientBrush>
        </Border.Background>
        <Panel>
            <!-- Quầng sáng sau logo -->
            <Ellipse Width="300" Height="220" Margin="-110,-120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.55" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#552563EB" />
                        <GradientStop Offset="0.55" Color="#1A06B6D4" />
                        <GradientStop Offset="1" Color="#0006B6D4" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <DockPanel Margin="14,16,14,14">

                <!-- ===== Logo + tên ===== -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="2,0,0,16">
                    <!-- Logo PSVH của psviethoa.com (bản chữ VH trắng cho nền tối), quầng sáng nhẹ phía sau cho biểu tượng xanh nổi lên -->
                    <Panel Name="Logo" Width="{Binding IsSidebarCompact, Converter={x:Static conv:AppConverters.LogoWidth}}" VerticalAlignment="Center" ToolTip.Tip="PSVIETHOA — psviethoa.com">
                        <Ellipse Margin="-10,-12" Opacity="0.55" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#663B82F6" />
                                    <GradientStop Offset="1" Color="#003B82F6" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image Source="avares://PsViethoa.FpkgBuilder.App/Assets/logo-dark.png" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1" IsVisible="{Binding !IsSidebarCompact}">
                        <TextBlock Text="PSVIETHOA" FontSize="15.5" FontWeight="Black" LetterSpacing="0.6" Foreground="#F8FAFC" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{l:T Shell.Product}" FontSize="11.5" FontWeight="SemiBold" Foreground="#7DD3FC" />
                            <Border Background="#1A7DD3FC" BorderBrush="#337DD3FC" BorderThickness="1" CornerRadius="5" Padding="5,0">
                                <TextBlock Text="{Binding HeaderVersion}" FontSize="10.5" FontWeight="Bold" Foreground="#BAE6FD" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Chân: ngôn ngữ, theme, cập nhật, hướng dẫn, thu gọn ===== -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <Border Height="1" Background="#1A2440" Margin="0,0,0,2" />
                    <Border Background="#0F1729" BorderBrush="#1E2A45" BorderThickness="1" CornerRadius="10" Padding="3" IsVisible="{Binding !IsSidebarCompact}" ToolTip.Tip="{l:T Header.LanguageTip}">
                        <Grid ColumnDefinitions="*,3,*">
                            <RadioButton Classes="sidelang" Theme="{StaticResource SegmentRadio}" GroupName="sidelang" Content="Tiếng Việt" IsChecked="{Binding LanguageVi, Mode=TwoWay}" />
                            <RadioButton Grid.Column="2" Classes="sidelang" Theme="{StaticResource SegmentRadio}" GroupName="sidelang" Content="English" IsChecked="{Binding LanguageEn, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <UniformGrid Rows="1" Columns="4" IsVisible="{Binding !IsSidebarCompact}">
                        <Button Classes="side" Margin="0,0,4,0" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeTooltip}">
                            <Panel>
                                <PathIcon Data="{StaticResource IconSun}" IsVisible="{Binding IsDarkTheme}" />
                                <PathIcon Data="{StaticResource IconMoon}" IsVisible="{Binding !IsDarkTheme}" />
                            </Panel>
                        </Button>
                        <Button Classes="side" Margin="2,0" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding !IsCheckingUpdate}" ToolTip.Tip="{l:T Update.Tip}">
                            <Panel>
                                <PathIcon Data="{StaticResource IconUpdate}" />
                                <Ellipse Width="8" Height="8" Fill="#4ADE80" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" IsVisible="{Binding UpdateAvailable}" />
                            </Panel>
                        </Button>
                        <Button Classes="side" Margin="2,0" Name="HelpButton" ToolTip.Tip="{l:T Header.HelpTip}">
                            <PathIcon Data="{StaticResource IconHelp}" />
                        </Button>
                        <Button Classes="side" Margin="4,0,0,0" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{l:T Shell.Collapse}">
                            <PathIcon Data="{StaticResource IconCollapse}" />
                        </Button>
                    </UniformGrid>
                    <Button Classes="side" IsVisible="{Binding IsSidebarCompact}" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{l:T Shell.Expand}">
                        <PathIcon Data="{StaticResource IconExpand}" />
                    </Button>
                </StackPanel>

                <!-- ===== Nhóm và mục ===== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                    <ItemsControl ItemsSource="{Binding NavGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="shell:NavGroup">
                                <StackPanel Margin="0,0,0,10">
                                    <!-- Đầu nhóm: huy hiệu hệ máy + tên + vạch -->
                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="6,0,2,6">
                                        <c:PlatformBadge Platform="{Binding Platform}" Size="24" IsBusy="{Binding IsBusy}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,10,0" FontSize="11" FontWeight="Bold" LetterSpacing="1.1"
                                                   Foreground="{Binding AccentBrush}" Opacity="0.95" VerticalAlignment="Center" IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IsSidebarCompact}" />
                                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="#1A2440" IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IsSidebarCompact}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="shell:NavItem">
                                                <RadioButton Classes="nav" GroupName="nav" IsVisible="{Binding IsShown}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Title}">
                                                    <Panel Height="44">
                                                        <Border Classes="navhover" CornerRadius="12" Background="#0FFFFFFF" />
                                                        <Border Classes="navsel" CornerRadius="12" Background="{Binding SelectedBrush}" BorderBrush="{Binding SelectedBorderBrush}" BorderThickness="1" />
                                                        <Border Classes="navrail" Width="3.5" Height="22" CornerRadius="2" HorizontalAlignment="Left" Margin="-1,0,0,0"
                                                                Background="{Binding AccentBrush}" BoxShadow="{Binding RailGlow}" />
                                                        <Panel Classes="navbody">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="9,0,8,0">
                                                                <Panel Width="32" Height="32" VerticalAlignment="Center">
                                                                    <Border Classes="navtile" CornerRadius="10" BorderThickness="1" />
                                                                    <Border Classes="navtilefill" CornerRadius="10" Background="{Binding TileBrush}" />
                                                                    <PathIcon Classes="navglyph" Data="{Binding Icon}" IsVisible="{Binding !IsSelected}" />
                                                                    <PathIcon Classes="navglyph" Data="{Binding Icon}" Foreground="{Binding TileInkBrush}" IsVisible="{Binding IsSelected}" />
                                                                </Panel>
                                                                <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center" Spacing="1" IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IsSidebarCompact}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Classes="navtitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                        <Ellipse Classes="busydot" Width="7" Height="7" Fill="{Binding AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                                                                    </StackPanel>
                                                                    <TextBlock Classes="navsub" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Classes="navindex" CornerRadius="6" BorderThickness="1" Padding="5,1" VerticalAlignment="Center"
                                                                        IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IsSidebarCompact}">
                                                                    <Panel>
                                                                        <TextBlock Classes="navindex mono" Text="{Binding Index}" FontSize="10.5" FontWeight="SemiBold" IsVisible="{Binding !IsSelected}" />
                                                                        <TextBlock Classes="mono" Text="{Binding Index}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding AccentBrush}" IsVisible="{Binding IsSelected}" />
                                                                    </Panel>
                                                                </Border>
                                                            </Grid>
                                                        </Panel>
                                                    </Panel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Panel>
    </Border>
</UserControl>
