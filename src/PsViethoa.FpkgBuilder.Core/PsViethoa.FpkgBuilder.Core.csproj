<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PsViethoa.FpkgBuilder.Core</RootNamespace>
    <AssemblyName>PsViethoa.FpkgBuilder.Core</AssemblyName>
    <Description>Lõi tạo gói FPKG PS5 đa nền tảng (macOS/Windows) trên nền LibProsperoPkg.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thư viện lõi PS5 PKG (managed .NET, chạy được trên macOS/Windows/Linux) -->
    <Reference Include="LibProsperoPkg">
      <HintPath>$(MSBuildThisFileDirectory)../../libs/LibProsperoPkg.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- PS4 PKG: đọc/xả gói, PFS, param.sfo (LibOrbisPkg của Maxton, LGPL-3.0; mã nguồn kèm trong libs/LibOrbisPkg) -->
    <Reference Include="LibOrbisPkg">
      <HintPath>$(MSBuildThisFileDirectory)../../libs/LibOrbisPkg/LibOrbisPkg.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Bảng chuỗi đa ngôn ngữ (vi/en) -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="PsViethoa.FpkgBuilder.Core.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/PythonCaseFold.txt" LogicalName="PsViethoa.FpkgBuilder.Core.Services.PythonCaseFold.txt" />
    <!-- Payload PS5 cho trang Resign Save (Garlic SaveMgr của earthonion), chỉ gửi tới máy khi người dùng bấm "Nạp ELF" -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../libs/garlic-savemgr/garlic-savemgr.elf" LogicalName="PsViethoa.FpkgBuilder.Core.GarlicSaveMgr.elf" />
    <!-- ZSTD PS5 (beta): runtime AMPR chạy trên PS5, ghi vào fakelib/libSceAmpr.sprx của game — nguyên byte, GPL-3.0-or-later (libs/ampr) -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../libs/ampr/ampr-emu-ng-0.3.4/libSceAmpr.sprx" LogicalName="PsViethoa.FpkgBuilder.Core.AmprEmuNg.sprx" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../libs/ampr/ampr_emu-0.4.2.1/libSceAmpr.sprx" LogicalName="PsViethoa.FpkgBuilder.Core.AmprEmu.sprx" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phụ thuộc của LibProsperoPkg (icon PNG -> DDS BC7) -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    <!-- ZSTD PS5 (beta): nén / giải khối zstd của gói ampr_zstd (managed, MIT) -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ổ ảo chỉ đọc trên Windows (gắn ảnh .exfat/.ffpfsc không sao chép, như hdiutil trên macOS). Chỉ là lớp .NET;
         driver Dokan (dokan2.dll) do người dùng cài, ứng dụng tự phát hiện và chỉ gọi khi có. -->
    <PackageReference Include="DokanNet" Version="2.3.0.3" />
  </ItemGroup>

</Project>
