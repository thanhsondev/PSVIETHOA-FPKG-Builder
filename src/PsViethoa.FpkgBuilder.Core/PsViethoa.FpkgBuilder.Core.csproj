<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PsViethoa.FpkgBuilder.Core</RootNamespace>
    <AssemblyName>PsViethoa.FpkgBuilder.Core</AssemblyName>
    <Description>Lõi tạo gói FPKG PS5 đa nền tảng (macOS/Windows) trên nền LibProsperoPkg.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thư viện lõi PS5 PKG (managed .NET, chạy được trên macOS/Windows/Linux) -->
    <Reference Include="LibProsperoPkg">
      <HintPath>$(MSBuildThisFileDirectory)../../libs/LibProsperoPkg.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Bảng chuỗi đa ngôn ngữ (vi/en) -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="PsViethoa.FpkgBuilder.Core.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/PythonCaseFold.txt" LogicalName="PsViethoa.FpkgBuilder.Core.Services.PythonCaseFold.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phụ thuộc của LibProsperoPkg (icon PNG -> DDS BC7) -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ổ ảo chỉ đọc trên Windows (gắn ảnh .exfat/.ffpfsc không sao chép, như hdiutil trên macOS). Chỉ là lớp .NET;
         driver Dokan (dokan2.dll) do người dùng cài, ứng dụng tự phát hiện và chỉ gọi khi có. -->
    <PackageReference Include="DokanNet" Version="2.3.0.3" />
  </ItemGroup>

</Project>
